{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(vault/**)",
      "Write(vault/**)",
      "Edit(exports/**)",
      "Write(exports/**)",
      "Bash(poopdeck *)",
      "Bash(poopdeck)",
      "Bash(python -m poopdeck *)",
      "Bash(pytest*)",
      "Bash(python -m pytest*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(./.env)",
      "Read(.env.*)",
      "Read(./.env.*)",
      "Edit(.env)",
      "Edit(./.env)",
      "Edit(.env.*)",
      "Edit(./.env.*)",
      "Write(.env)",
      "Write(./.env)",
      "Write(.env.*)",
      "Write(./.env.*)",
      "Bash(git push*)",
      "Bash(git push *)",
      "Bash(git -C vault push*)",
      "Bash(git add -f*)",
      "Bash(git add -f *)",
      "Bash(git add --force*)",
      "Bash(git add --force *)",
      "Bash(git add vault*)"
    ]
  }
}
